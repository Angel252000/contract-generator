# Copia este archivo a .env y completa lo que necesites.
# Proveedor de IA: se elige solo (primera clave que encuentre; si no hay, Ollama si está abierto;
# si no, modo plantilla sin IA). Para forzarlo: AI_PROVIDER=anthropic|groq|gemini|ollama|plantilla
# AI_PROVIDER=

# --- Gratis ---
# Ollama (local, sin clave): https://ollama.com  →  ollama pull gemma3:4b
# OLLAMA_MODEL=gemma3:1b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Groq (nube, plan gratuito): https://console.groq.com/keys
GROQ_API_KEY=

# Gemini (nube, plan gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- De pago ---
ANTHROPIC_API_KEY=

# Modelo del proveedor elegido (opcional; cada uno tiene uno por defecto)
# AI_MODEL=

# Servidor web (opcional)
HOST=127.0.0.1
PORT=5050
# FLASK_DEBUG=1
